// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"proxy": "",
 "disable_ai": true,
 "which_key": {
  "enabled": false
 },
 "window_decorations": "server",
	"focus_follows_mouse": {
		"enabled": false,
	},
	"tab_bar": {
		"show_pinned_tabs_in_separate_row": false,
  "show_tab_bar_buttons": false,
  "show_nav_history_buttons": false,
	},
	"debugger": {
		"button": false,
	},
	"cli_default_open_behavior": "existing_window",
	"git_panel": {
		"dock": "left",
	},
	"toolbar": {
		"breadcrumbs": false,
  "selections_menu": true,
  "quick_actions": false,
		"agent_review": false,
	},
	"status_bar": {
		"cursor_position_button": false,
		"active_encoding_button": "non_utf8",
		"active_language_button": true,
	},
	"search": {
		"button": false,
	},
	"diagnostics": {
		"button": false,
	},
	"agent": {
		"enable_feedback": false,
  "sidebar_side": "right",
		"dock": "right",
		"button": false,
		"favorite_models": [],
		"model_parameters": [],
	},
	"collaboration_panel": {
		"dock": "left",
		"button": false,
	},
	"outline_panel": {
		"dock": "left",
		"button": false,
	},
	"hard_tabs": true,
	"tab_size": 4,
	"indent_guides": {
		"coloring": "indent_aware",
		"background_coloring": "indent_aware",
	},
	"title_bar": {
		"show_project_items": false,
  "show_branch_status_icon": true,
		"show_user_picture": false,
		"show_user_menu": false,
		"show_sign_in": false,
		"show_onboarding_banner": false,
	},
	"terminal": {
		"button": false,
	},
	"show_edit_predictions": false,
	"tabs": {
		"git_status": true,
		"file_icons": true,
	},
	"cursor_shape": "block",
	"ui_font_weight": 400.0,
	"ui_font_family": "BigBlueTerm437 Nerd Font",
	"buffer_line_height": {
		"custom": 2.0,
	},
	"lsp": {
		"java": {
			"settings": {
				"check_updates": "never", // Never check/download updates
				"jdk_auto_download": false, // Prevent auto JDK downloads
			},
		},
	},
	"languages": {
		"C": {
			"tab_size": 4,
			"format_on_save": "on",
		},
	},
	"buffer_font_family": "BigBlueTerm437 Nerd Font Mono",
	"project_panel": {
		"button": true,
		"dock": "right",
		"auto_fold_dirs": false,
	},
	"icon_theme": "Terraria Icons",
	"ui_font_size": 14.0,
	"buffer_font_size": 15.0,
	"theme": "Terraria Dark",
}
